# Mac dinh SQLite: khong can cai dat PostgreSQL
DATABASE_URL=sqlite:///./data/observability.db
# Neu chay Docker, docker-compose da cai dat PostgreSQL tu dong.
# DATABASE_URL=postgresql+psycopg://observability:observability@localhost:5432/observability
API_BASE_URL=http://localhost:8000
SCHEDULER_INTERVAL_SECONDS=300

# Task 2: defaults used by comparisons and displayed thresholds
DQ_FRESHNESS_MINUTES=60
DQ_COMPLETENESS=0.98
DQ_UNIQUENESS=0.995

# Task 3: HEALTHY history; KS compares adjacent run snapshots
ZSCORE_THRESHOLD=3
ZSCORE_MIN_HISTORY=5
KS_ALPHA=0.05
KS_MIN_SAMPLES=20
KS_EFFECT_THRESHOLD=0.1

# Task 5: offline by default. Enable both switches only to permit external requests.
LLM_MODE=offline
LLM_ALLOW_EXTERNAL=false
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=10
